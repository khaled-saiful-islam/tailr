# Production front door (docker-compose.prod.yml). Caddy gets and renews the
# HTTPS certificate from Let's Encrypt by itself, redirects HTTP to HTTPS, and
# passes everything to nginx, which serves the app and proxies /api.
#
# SITE_ADDRESS comes from .env: tailr.stream once the domain is bought, or a
# free sslip.io name for the server's IP until then (203-0-113-7.sslip.io).

{$SITE_ADDRESS} {
	# Caddy replaces any X-Forwarded-For the visitor sent with their real address;
	# nginx trusts it from here (deploy/nginx/real-ip.conf), and rate limits use it.
	# By container name: other apps on this server (Starboard) join this network with their own "frontend".
	reverse_proxy tailr-frontend:80

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	log {
		output stdout
		format console
	}
}

# Other apps sharing this server add their own site here (Starboard writes deploy/sites/starboard.caddy
# when it deploys). git ignores those files, so a Tailr deploy never touches them.
import /etc/caddy/sites/*.caddy
