# ── Tailr production configuration ──────────────────────────────────
# scripts/prod-env.sh copies this to .env on the server and fills in the
# address, the secrets and the ILMU key. Never commit the real .env.
# In production the API refuses to start with a default secret, the default
# admin password, insecure cookies, no AI key, or email pointed at Mailpit.

APP_ENV=production
LOG_LEVEL=INFO
SECRET_KEY=

# The public name, without https://. Caddy gets the certificate for it.
# Until a domain is bought: the server's IP with dashes, plus .sslip.io.
SITE_ADDRESS=
PUBLIC_WEB_URL=
CORS_ORIGINS=
COOKIE_SECURE=true

# ── Database ────────────────────────────────────────────────────────
POSTGRES_USER=tailr
POSTGRES_PASSWORD=
POSTGRES_DB=tailr

# ── AI: ILMU (OpenAI-compatible) ────────────────────────────────────
LLM_BASE_URL=https://api.ilmu.ai/v1
LLM_API_KEY=
LLM_MODEL=ilmu-v3.1
LLM_FAST_MODEL=ilmu-mini-v3.3
LLM_VISION_MODEL=ilmu-vision-v1.3
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
RERANK_MODEL=bge-reranker
AI_DAILY_BUDGET_TOKENS=1500000

# ── Job sources ─────────────────────────────────────────────────────
SOURCES_ENABLED=linkedin,jobstreet
SOURCE_SEARCH_CACHE_SECONDS=3600
SOURCE_REQUESTS_PER_MINUTE=20

# ── Email ───────────────────────────────────────────────────────────
# Off until the domain has a mail provider (SPF and DKIM records set up).
# Then: EMAIL_ENABLED=true and the provider's SMTP settings below.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
# starttls (port 587) or ssl (port 465)
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Tailr <hello@tailr.stream>

# ── Default admin (created on first start) ──────────────────────────
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=admin@tailr.local
