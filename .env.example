# ── Tailr configuration ─────────────────────────────────────────────
# Copy to .env (make setup does this). Never commit .env.

APP_ENV=development
LOG_LEVEL=INFO
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-secret-change-me
PUBLIC_WEB_URL=http://localhost:8400
CORS_ORIGINS=http://localhost:8400,http://localhost:8403
COOKIE_SECURE=false

# ── Ports on your machine ───────────────────────────────────────────
WEB_PORT=8400
API_PORT=8401
DB_PORT=8402
DEV_PORT=8403
REDIS_PORT=8404
MAIL_UI_PORT=8405

# ── Database ────────────────────────────────────────────────────────
POSTGRES_USER=tailr
POSTGRES_PASSWORD=tailr
POSTGRES_DB=tailr

# ── AI: ILMU (OpenAI-compatible) ────────────────────────────────────
LLM_BASE_URL=https://api.ilmu.ai/v1
LLM_API_KEY=
LLM_MODEL=ilmu-v3.1
LLM_FAST_MODEL=ilmu-mini-v3.3
LLM_VISION_MODEL=ilmu-vision-v1.3
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
RERANK_MODEL=bge-reranker
AI_DAILY_BUDGET_TOKENS=1500000

# ── Job sources ─────────────────────────────────────────────────────
# Comma-separated. Remove one to switch that source off everywhere.
SOURCES_ENABLED=linkedin,jobstreet
SOURCE_SEARCH_CACHE_SECONDS=3600
SOURCE_REQUESTS_PER_MINUTE=20

# ── Email (dev: Mailpit catches everything at http://localhost:8405) ─
EMAIL_ENABLED=true
SMTP_FROM=Tailr <brief@tailr.local>

# ── Demo account (make demo) ────────────────────────────────────────
DEMO_EMAIL=demo@tailr.app
DEMO_PASSWORD=tailr-demo-1

# ── Default admin (created on first start) ──────────────────────────
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin
SEED_ADMIN_EMAIL=admin@tailr.local
