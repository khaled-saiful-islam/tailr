# Copy to .env.deploy (git ignores it) and fill in, for `make deploy` and the
# other prod-* targets. The server's address stays out of the public repo.
DEPLOY_HOST=ubuntu@<server-ip>
DEPLOY_KEY=~/.ssh/tailr-oci
DEPLOY_DIR=/opt/tailr
# Where the health check goes after a deploy: https:// plus SITE_ADDRESS.
DEPLOY_URL=https://<server-ip-with-dashes>.sslip.io
